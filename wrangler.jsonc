// Cloudflare Workers config for kaput.media (added 2026-11-06, github-access-scoping Part 2).
// Static files are served from the repo root. worker.js runs ONLY for paths with no matching
// file: it sends them to the home page (or to /rates). Never remove workers_dev / preview_urls:
// without them every deploy reopens public bypass URLs (dashboard lesson, 2026-07-01).
{
  "name": "kaput-media",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
